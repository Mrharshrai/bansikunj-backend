# ---------------------------------------------------------------------------
# Bansikunj backend - environment template
# Copy to `.env` and fill in real values. `.env` is gitignored; never commit it.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Application ----------------------------------------------------------
APP_NAME="Bansikunj API"
APP_VERSION="0.1.0"
# local | dev | staging | production
ENVIRONMENT="local"
DEBUG=false
API_V1_PREFIX="/api/v1"

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_USER=postgres
# Optional when DATABASE_URL is set (hosted deployments usually set only the URL).
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bansikunj
# Host port published by docker-compose.yml. 5434 avoids the development
# PostgreSQL on 5432 and the test cluster on 5433.
DB_HOST_PORT=5434
# Optional: a full DSN that overrides the parts above. Provider URLs are
# normalised automatically (`postgresql://` -> `postgresql+asyncpg://`, and
# libpq's `sslmode`/`channel_binding` -> asyncpg's `ssl=require`).
# Neon example:
# DATABASE_URL="postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
# Reconnect cleanly after a hosted database suspends idle connections.
DB_POOL_PRE_PING=true
DB_ECHO=false
DB_CONNECT_TIMEOUT=10

# --- JWT (Phase 2) --------------------------------------------------------
# Must be at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-random-48-byte-urlsafe-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Password hashing (Phase 2) -------------------------------------------
PASSWORD_ARGON2_TIME_COST=3
PASSWORD_ARGON2_MEMORY_COST_KIB=65536
PASSWORD_ARGON2_PARALLELISM=4

# --- Razorpay (Phase 6) ---------------------------------------------------
# Use test-mode keys locally. The key id is public (it reaches the browser);
# the key secret and webhook secret are server-only and must never be logged.
# Checkout signature = HMAC-SHA256("<order_id>|<payment_id>", KEY_SECRET).
# Webhook signature = HMAC-SHA256(raw_body, WEBHOOK_SECRET).
# Leave unset to keep online payments disabled (503, while COD still works).
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# --- SMTP / Email (Phase 7) -----------------------------------------------
# Phase 7 currently uses a MOCK transport: verification/reset emails are written
# to the app log and a bounded in-memory outbox, not sent. Leave SMTP_HOST unset
# until the real provider is implemented behind app/services/email_service.py.
# The auth flows already call EmailService, so wiring a provider needs no route
# changes.
# SMTP_HOST=
SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@bansikunj.in
SMTP_FROM_NAME=Bansikunj
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# --- Cloudinary (Phase 3+) ------------------------------------------------
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=bansikunj

# --- Redis (Phase 9) ------------------------------------------------------
# REDIS_URL="redis://localhost:6379/0"

# --- CORS / Frontend ------------------------------------------------------
FRONTEND_URL=http://localhost:4200
# Comma-separated extra origins. Never use `*` when ENVIRONMENT=production.
CORS_ORIGINS=

# --- Logging --------------------------------------------------------------
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# LOG_FORMAT: console | json  (use json in production)
LOG_FORMAT=console

# --- Hosted deployment (Render + Neon) ------------------------------------
# Set these in the Render dashboard, not in a committed file:
#   ENVIRONMENT=production
#   DEBUG=false
#   LOG_FORMAT=json
#   DATABASE_URL=<Neon connection string>
#   JWT_SECRET_KEY=<random 48-byte urlsafe string>
#   DB_POOL_RECYCLE=300       # Neon suspends idle computes after ~5 minutes
#   DB_POOL_PRE_PING=true
# Razorpay, SMTP, Cloudinary, and Redis may stay unset; the related features
# fail closed with 503 instead of preventing the API from starting.
